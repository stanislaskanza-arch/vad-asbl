# ============================================================
#  Variables d'environnement — VAD
#  Copiez ce fichier en ".env" et remplissez les valeurs.
#  ⚠️ Ne partagez JAMAIS le fichier .env (il contient des secrets).
# ============================================================

# Port du serveur (Render gère automatiquement, garder 4000 pour test local)
PORT=4000

# Secret JWT (CHANGEZ-LE en production ! une longue chaîne aléatoire)
JWT_SECRET=mettez-ici-une-phrase-longue-et-secrete-2026

# URL publique de l'application (pour les liens de parrainage)
# Sur Render : https://votre-app.onrender.com
PUBLIC_BASE_URL=https://votre-app.onrender.com

# Base de données
# --- Pour test LOCAL (SQLite) ---
DATABASE_URL="file:./vad.db"
# --- Pour PRODUCTION (PostgreSQL sur Render) ---
# Render remplit cette variable AUTOMATIQUEMENT quand vous créez une base PostgreSQL.
# Exemple: DATABASE_URL="postgresql://user:pass@host:5432/dbname"
